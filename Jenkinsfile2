pipeline {
    agent any

    tools {
        maven 'maven_1'
    }

    environment {
        GITHUB_USER      = 'someshtarra'
        USER             = 'somesh'
        USER_MAIL        = 'someshtarra@gmail.com'

        GITHUB_REPO_URL  = 'https://github.com/someshtarra/project-management.git'
        GITHUB_REPO_NAME = 'project-management'
        GITHUB_BRANCH    = 'main'

        DOCKER_USER      = 'someshtarra'
        DOCKER_IMAGE     = 'someshtarra/javaproject'

        GITOPS_REPO_URL  = 'https://github.com/someshtarra/GITOPS.git'
        GITOPS_REPO_NAME = 'GITOPS'
        GITOPS_BRANCH    = 'main'
    }

    stages {

        stage('Checkout Application') {
            steps {
                echo 'Cloning application repository'

                dir('application') {
                    git branch: env.GITHUB_BRANCH,
                        url: env.GITHUB_REPO_URL
                }
            }
        }

        stage('Build and Unit Test') {
            steps {
                echo 'Building and running unit tests'

                dir('application') {
                    sh 'mvn clean test'
                }
            }
        }

        stage('SonarQube Scan') {
            steps {
                echo 'Running SonarQube scan'

                dir('application') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Artifact') {
            steps {
                echo 'Building Maven artifact'

                dir('application') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image'

                dir('application') {
                    sh '''
                        docker build \
                            -t "$DOCKER_IMAGE:$BUILD_NUMBER" \
                            -f Dockerfile .
                    '''
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                echo 'Scanning Docker image with Trivy'

                sh "trivy image --severity HIGH,CRITICAL ${env.DOCKER_IMAGE}:${env.BUILD_NUMBER}"
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo 'Pushing image to Docker Hub'

                withCredentials([
                    string(
                        credentialsId: 'dockerhub', variable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USER" --password-stdin

                        docker push "$DOCKER_IMAGE:$BUILD_NUMBER"
                    '''
                }
            }
        }

        stage('Checkout GitOps Repository') {
            steps {
                echo 'Cloning GitOps repository'

                dir('gitops') {
                    git branch: env.GITOPS_BRANCH,
                        url: env.GITOPS_REPO_URL
                }
            }
        }

        stage('Update GitOps YAML') {
            steps {
                echo 'Updating deployment image'

                dir('gitops') {
                    withCredentials([
                        string(
                            credentialsId: 'githubtoken',
                            variable: 'GITHUB_TOKEN'
                        )
                    ]) {
                        sh '''
                            git config user.name "$USER"
                            git config user.email "$USER_MAIL"

                            sed -i "s|image:.*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" Deployment/deploy.yaml

                            git add .

                            git commit -m "Update image tag ${BUILD_NUMBER}" || true
                            git push https://${GITHUB_TOKEN}@github.com/${GITHUB_USER}/${GITOPS_REPO_NAME}.git HEAD:${GITOPS_BRANCH}
                        '''
                    }
                }
            }
        }
    }
}
